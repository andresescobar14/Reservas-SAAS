PORT=3001
HOST=127.0.0.1
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Mismo proyecto Supabase del frontend. Usar publishable/anon; nunca service_role.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# LocalAuth requiere un disco persistente. Rutas relativas a whatsapp-engine.
WHATSAPP_AUTH_PATH=.wwebjs_auth
MAX_SESSIONS=10

# Opcional: Chrome/Chromium propio; por defecto se usa el descargado por Puppeteer.
PUPPETEER_EXECUTABLE_PATH=
