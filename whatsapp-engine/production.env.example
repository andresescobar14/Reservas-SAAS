# Valores para el servicio del motor; no son variables de la interfaz de Vercel.
NODE_ENV=production
HOST=0.0.0.0
PORT=3001
CORS_ORIGINS=https://reservas-saas-ae.vercel.app
WHATSAPP_AUTH_PATH=/var/lib/whatsapp
# Empezar con una sesión para el límite de memoria de la prueba de Railway.
MAX_SESSIONS=1

# Mismo proyecto Supabase que usa la web. Completar desde la configuración existente.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
