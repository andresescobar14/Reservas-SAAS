# Copia este archivo como .env.local y usa los valores de Supabase > Settings > API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# URL pública del frontend. En producción reemplazar por el dominio real.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Clave privada de al menos 32 caracteres para la verificación opcional.
# Ya fue generada en .env.local. Configúrala también en producción.
# No usar un prefijo NEXT_PUBLIC_ para esta clave.
EMAIL_VERIFICATION_SECRET=

# URL HTTPS de checkout alojado, cuando se integre el proveedor de pagos.
# No activa suscripciones: el webhook del proveedor deberá hacerlo desde backend.
BILLING_CHECKOUT_URL=
