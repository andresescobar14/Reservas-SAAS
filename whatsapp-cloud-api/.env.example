NODE_ENV=production
# Railway sustituye PORT por el puerto asignado al servicio.
PORT=3001
HOST=0.0.0.0
DB_MODE=postgres
# Conexión PostgreSQL/Supabase del servidor; nunca NEXT_PUBLIC_.
DATABASE_URL=
# Opcional: certificado PEM de la CA de tu proveedor, con saltos de línea reales.
PG_CA_CERT=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Usar la versión soportada que muestre el panel de tu app de Meta, ej. vNN.0.
META_GRAPH_VERSION=
META_APP_SECRET=
# IDs públicos de la aplicación y de Facebook Login for Business (variación WhatsApp).
META_APP_ID=
META_SIGNUP_CONFIG_ID=
# Activar solo tras configurar dominios, revisión/permisos y webhooks de Coexistencia en Meta.
META_SIGNUP_ENABLED=false
# Prueba privada por empresa para administradores/desarrolladores de la app de Meta.
# No sustituye la elegibilidad, verificación ni permisos de Meta. Vacío por defecto.
META_SIGNUP_TEST_COMPANY_IDS=
# Compatibilidad antigua desactivada: toda la programación se ejecuta en Railway.
LEGACY_MAKE_ENABLED=false
WEBHOOK_VERIFY_TOKEN=
# Generar 32 bytes aleatorios y codificarlos como 64 caracteres hexadecimales.
META_TOKEN_ENCRYPTION_KEY=
BUTTON_SIGNING_SECRET=
CORS_ORIGINS=https://reservas-saas-ae.vercel.app,http://localhost:3000
WHATSAPP_TEMPLATE_NAME=recordatorio_cita
WHATSAPP_CONFIRMATION_TEMPLATE_NAME=reserva_confirmacion
WHATSAPP_TEMPLATE_LANGUAGE=es_MX
# Usar 3002 en desarrollo si el motor QR anterior ocupa 3001.
