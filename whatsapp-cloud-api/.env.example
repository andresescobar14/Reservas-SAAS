NODE_ENV=production
# Railway sustituye PORT por el puerto asignado al servicio.
PORT=3001
HOST=0.0.0.0
DB_MODE=postgres
# Conexión PostgreSQL/Supabase del servidor; nunca NEXT_PUBLIC_.
DATABASE_URL=
# Opcional: certificado PEM de la CA de tu proveedor, con saltos de línea reales.
PG_CA_CERT=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Usar la versión soportada que muestre el panel de tu app de Meta, ej. vNN.0.
META_GRAPH_VERSION=
META_APP_SECRET=
WEBHOOK_VERIFY_TOKEN=
# Generar 32 bytes aleatorios y codificarlos como 64 caracteres hexadecimales.
META_TOKEN_ENCRYPTION_KEY=
BUTTON_SIGNING_SECRET=
CORS_ORIGINS=https://reservas-saas-ae.vercel.app,http://localhost:3000
WHATSAPP_TEMPLATE_NAME=recordatorio_cita
WHATSAPP_TEMPLATE_LANGUAGE=es_MX
# Usar 3002 en desarrollo si el motor QR anterior ocupa 3001.
